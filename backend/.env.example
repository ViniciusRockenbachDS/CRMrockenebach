# ===================================================================
# CRM API — variáveis de ambiente do backend
# Copie para backend/.env e ajuste os valores.
# ===================================================================

# --- Aplicação -------------------------------------------------------
APP_NAME="CRM API"
APP_ENV=development            # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Banco de dados (PostgreSQL) -----------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password
POSTGRES_DB=crm
# Opcional: se definida, sobrescreve os campos acima.
# Formato: postgresql+asyncpg://usuario:senha@host:porta/banco
# DATABASE_URL=

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Banco usado pelo pytest (docker compose --profile test up -d)
TEST_DATABASE_URL=postgresql+asyncpg://crm_test:crm_test@localhost:5433/crm_test

# --- Autenticação JWT ----------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=troque-esta-chave-em-producao-use-pelo-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Usuário administrador criado pelo seed inicial
FIRST_ADMIN_NAME=Administrador
FIRST_ADMIN_EMAIL=admin@crm.local
FIRST_ADMIN_PASSWORD=Admin@12345

# --- Paginação ------------------------------------------------------
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# --- Inteligência Artificial ---------------------------------------
# "stub" devolve respostas determinísticas sem chamar nenhuma API externa.
AI_ENABLED=true
AI_PROVIDER=stub               # stub | openai | anthropic
# Obrigatórios quando AI_PROVIDER for openai ou anthropic.
# AI_MODEL: nome exato do modelo, conforme a documentação do provedor que você usar.
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_CACHE_TTL_HOURS=24          # reaproveita insights gerados recentemente
