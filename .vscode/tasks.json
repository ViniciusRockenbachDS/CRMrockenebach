{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Banco: subir PostgreSQL (Docker)",
      "type": "shell",
      "command": "docker compose up -d",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "2. Backend: preparar banco (migrations)",
      "type": "shell",
      "command": ".venv/bin/python -m app.scripts.init_db",
      "windows": { "command": ".venv\\Scripts\\python.exe -m app.scripts.init_db" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "3. Backend: dados de demonstração",
      "type": "shell",
      "command": ".venv/bin/python -m app.scripts.seed --demo",
      "windows": { "command": ".venv\\Scripts\\python.exe -m app.scripts.seed --demo" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: rodar API",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn app.main:app --reload --port 8000",
      "windows": { "command": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Frontend: rodar",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "CRM: iniciar tudo",
      "dependsOn": ["1. Banco: subir PostgreSQL (Docker)", "Backend: rodar API", "Frontend: rodar"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Backend: testes (pytest)",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -v",
      "windows": { "command": ".venv\\Scripts\\python.exe -m pytest -v" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
